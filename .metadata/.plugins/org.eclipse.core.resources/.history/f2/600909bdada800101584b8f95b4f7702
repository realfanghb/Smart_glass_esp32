#endif

#include <stdint.h>
#include "esp_err.h"

/**
 * @brief 初始化并启动 SoftAP（使用默认配置，见 softAP.c 顶部宏）。
 *        - 会创建 Wi-Fi AP 接口
 *        - 启动 esp_wifi
 */
void wifi_init_softap(void);

/**
 * @brief 启动 MJPEG TCP 推流任务（线程安全，可反复调用只会创建一个任务）。
 * @param port TCP 监听端口；传 0 则使用默认端口（宏 SOFTAP_TCP_PORT，默认 3333）
 */
void softap_tcp_stream_start(uint16_t port);

