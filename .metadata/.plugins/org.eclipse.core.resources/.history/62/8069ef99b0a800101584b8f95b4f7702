#include <string.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_log.h"
#include "driver/gpio.h"
#include "driver/adc.h"
#include "esp_adc/adc_cali.h"
#include "esp_adc/adc_cali_scheme.h"
#include "softAP.h" // 提供 softap_send_one_jpeg()
#include "keypad_snapshot.h"


static const char *TAG_K = "keypad_snap";


static TaskHandle_t s_task = NULL;
static adc_oneshot_unit_handle_t s_adc = NULL;
static adc_channel_t s_ch;
static adc_unit_t s_unit;


static int read_adc_average_raw(void)
{
int sum = 0;
for (int i = 0; i < ADC_SAMPLE_TIMES; ++i) {
int raw = 0;
if (adc_oneshot_read(s_adc, s_ch, &raw) != ESP_OK) return -1;
sum += raw;
ets_delay_us(150);
}
return sum / ADC_SAMPLE_TIMES;
}


static void keypad_task(void *arg)
{
TickType_t last_print = 0;
bool in_window = false;
TickType_t t_enter = 0;


while (1) {
int raw = read_adc_average_raw();
if (raw < 0) {
ESP_LOGW(TAG_K, "ADC read fail");
vTaskDelay(pdMS_TO_TICKS(ADC_POLL_MS));
continue;
}
TickType_t now = xTaskGetTickCount();
if (now - last_print > pdMS_TO_TICKS(ADC_PRINT_INTERVAL_MS)) {
ESP_LOGI(TAG_K, "[adc] raw=%d (PLAY %d~%d)", raw, PLAY_MIN_RAW, PLAY_MAX_RAW);
last_print = now;
}
bool in_play = (raw >= PLAY_MIN_RAW && raw <= PLAY_MAX_RAW);


if (!in_window && in_play) {
vTaskDelay(pdMS_TO_TICKS(ADC_DEBOUNCE_MS));
int raw2 = read_adc_average_raw();
if (raw2 >= PLAY_MIN_RAW && raw2 <= PLAY_MAX_RAW) {
in_window = true;
t_enter = xTaskGetTickCount();
}
}
if (in_window) {
if (now - t_enter >= pdMS_TO_TICKS(ADC_PRESS_HOLD_MS)) {
ESP_LOGI(TAG_K, "PLAY pressed -> snapshot on %d", SNAPSHOT_TCP_PORT);
esp_err_t r = softap_send_one_jpeg(SNAPSHOT_TCP_PORT);
if (r != ESP_OK) {
ESP_LOGW(TAG_K, "snapshot failed: 0x%x", r);
}
}